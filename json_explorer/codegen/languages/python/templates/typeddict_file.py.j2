"""Generated TypedDict classes from JSON schema."""
{%- if imports %}

{%- for import_stmt in imports %}
{{ import_stmt }}
{%- endfor %}
{%- endif %}

{%- for class in classes %}

{% if class.functional %}
{{ class.class_name }} = TypedDict(
    "{{ class.class_name }}",
    {
{%- for field in class.fields %}
{%- if field.comment %}
        # {{ field.comment }}
{%- endif %}
        {{ field.key }}: {{ field.type }},
{%- endfor %}
    },
{%- if not class.total %}
    total=False,
{%- endif %}
)
{%- else %}

class {{ class.class_name }}(TypedDict
{%- if not class.total %}, total=False{% endif %}):
{%- if class.description %}
    """{{ class.description }}"""
{%- endif %}
{%- for field in class.fields %}
{%- if field.comment %}
    # {{ field.comment }}
{%- endif %}
    {{ field.name }}: {{ field.type }}
{%- endfor %}
{%- if not class.fields %}
    pass
{%- endif %}
{%- endif %}
{%- endfor %}